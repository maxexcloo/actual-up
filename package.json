{
  "description": "Synchronise Up transactions into Actual Budget.",
  "exports": "./dist/index.js",
  "license": "AGPL-3.0-only",
  "name": "actual-up",
  "type": "module",
  "version": "0.2.5",
  "allowScripts": {
    "@parcel/watcher": false,
    "better-sqlite3": true,
    "esbuild": true
  },
  "bin": {

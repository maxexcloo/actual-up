  },
  "dependencies": {
    "@actual-app/api": "26.10.0",
    "@awesome.me/webawesome": "3.14.0",
    "commander": "15.0.0",
    "croner": "10.0.1",
    "fastify": "5.12.7",
    "htmx.org": "2.0.11",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:ui",
    "build:ui": "node assets/build.mjs",
    "start": "node dist/cli.js serve"

{
  "description": "Synchronise Up transactions into Actual Budget.",
  "exports": "./dist/index.js",
  "license": "AGPL-3.0-only",
  "name": "actual-up",
  "type": "module",
  "version": "0.2.5",
  "allowScripts": {
    "@parcel/watcher": false,
    "better-sqlite3": true,
    "esbuild": true
  },
  "bin": {
    "actual-up": "dist/cli.js"
  },
  "dependencies": {
    "@actual-app/api": "26.10.0",
    "commander": "15.0.0",
    "croner": "10.0.1",
    "fastify": "5.12.5",
    "htmx.org": "2.0.11",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.6.5",
    "daisyui": "5.7.48",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:css",
    "build:css": "tailwindcss -i assets/style.css -o dist/style.css --minify",
    "check": "updatecli manifest validate --config .updatecli.d --disable-templating --strict && npm run format:check && npm run lint && npm run typecheck && npm test",
    "dev": "npm run build && node dist/cli.js serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src test",
    "start": "node dist/cli.js serve",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}

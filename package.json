{
  "name": "actual-up",
  "version": "0.2.1",
  "description": "Synchronise Up transactions into Actual Budget.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "actual-up": "dist/cli.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run build:css",
    "check": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm run test",
    "dev": "pnpm run build:css && tsx src/cli.ts serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src test",
    "start": "node dist/cli.js serve",
    "test": "vitest run",
    "build:css": "tailwindcss -i assets/style.css -o dist/style.css --minify"
  },
  "dependencies": {
    "@actual-app/api": "26.10.0",
    "commander": "15.0.0",
    "croner": "10.0.1",
    "fastify": "5.12.5",
    "htmx.org": "2.0.11",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.6.4",
    "daisyui": "5.7.47",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
